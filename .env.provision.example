# Supabase Remote Provisioning Configuration
# Copy this file to .env.provision.local and fill in your actual values
# NEVER commit .env.provision.local to version control

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
DEMO_USER_PASSWORD=DEFINE_A_STRONG_DEMO_PASSWORD
