# Supabase Edge Functions environment variables.
# Copy this file to supabase/.env and adjust for your environment.
#
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are
# injected automatically by `supabase functions serve` / `supabase start`.

# Comma-separated list of allowed web origins for CORS and invite redirect
# validation. For local dev, include the Vite dev server URL.
# In production, set this to the deployed frontend URL(s).
ALLOWED_WEB_ORIGINS=http://localhost:5173
