# Security headers for static SPA hosting (Netlify / Cloudflare Pages).
# Apply to all routes. Adjust per-deployment as needed.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Static assets — long cache (immutable, content-hashed by Vite)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service worker — short cache so updates are picked up quickly
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
/workbox-*.js
  Cache-Control: public, max-age=0, must-revalidate

# index.html — never cache (entry point must always be fresh)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
